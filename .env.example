DATABASE_PATH=data/kartly.db
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Evaluation-only on-disk response cache. Leave off for normal /ask requests.
EVAL_CACHE=0
# Estimated USD per 1M tokens; edit to match your model. The free tier costs
# nothing, but we log an estimate as if paid.
PRICE_INPUT_PER_MTOK=0.15
PRICE_OUTPUT_PER_MTOK=0.60
# Check the Groq console for current model names.
ROUTER_MODEL=replace-with-current-groq-router-model
ANSWER_MODEL=replace-with-current-groq-answer-model
LOG_LEVEL=INFO
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WARMUP_ON_STARTUP=true
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=4
# Chunks with cosine distance above this are treated as not relevant.
RELEVANCE_MAX_DISTANCE=0.62
RETURN_WINDOW_DAYS=30
JOBS_DB_PATH=data/jobs.db
MAX_UPLOAD_BYTES=200000
